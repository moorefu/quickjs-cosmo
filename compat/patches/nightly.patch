+static textwindows bool qjs_is_ape(const char *p, size_t n) {
+  return n >= 8 && !memcmp(p, "MZqFpD='", 8);
+}
+
+static textwindows bool qjs_interpreter_is_ape(const char16_t *path) {
+  char magic[8];
+  intptr_t handle = CreateFile(path, kNtFileGenericRead,
+      kNtFileShareRead | kNtFileShareWrite | kNtFileShareDelete,
+      0, kNtOpenExisting, kNtFileAttributeNormal, 0);
+  if (handle == -1)
+    return false;
+  uint32_t got = 0;
+  bool ok = ReadFile(handle, magic, sizeof(magic), &got, 0);
+  CloseHandle(handle);
+  return ok && qjs_is_ape(magic, got);
+}
+
+static textwindows bool qjs_protocol_variable(const char16_t *entry) {
+  const char *const names[] = {"_COSMO_FDS=", "_COSMO_FDS_V2=", "_MASK="};
+  for (unsigned i = 0; i < sizeof(names) / sizeof(*names); ++i) {
+    size_t j;
+    for (j = 0; names[i][j]; ++j) {
+      unsigned c = entry[j];
+      if (c >= 'a' && c <= 'z')
+        c -= 'a' - 'A';
+      if (c != names[i][j])
+        break;
+    }
+    if (!names[i][j])
+      return true;
+  }
+  return false;
+}
+
+/* An ordinary Windows program must not forward transient APE handle records. */
+static textwindows void qjs_strip_protocol(char16_t *block) {
+  char16_t *source = block, *target = block;
+  while (*source) {
+    size_t length = strlen16(source) + 1;
+    if (!qjs_protocol_variable(source)) {
+      memmove(target, source, length * sizeof(*source));
+      target += length;
+    }
+    source += length;
+  }
+  *target = 0;
+  if (target == block)
+    target[1] = 0;
+}
