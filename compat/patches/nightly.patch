+/* An ordinary Windows program must not forward transient APE handle records. */
+static textwindows void qjs_strip_protocol(char16_t *block) {
+  char16_t *source = block, *target = block;
+  while (*source) {
+    size_t length = strlen16(source) + 1;
+    if (!qjs_protocol_variable(source)) {
+      memmove(target, source, length * sizeof(*source));
+      target += length;
+    }
+    source += length;
+  }
+  *target = 0;
+  if (target == block)
+    target[1] = 0;
+}
