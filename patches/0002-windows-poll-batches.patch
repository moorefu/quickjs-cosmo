--- a/quickjs-libc.c
+++ b/quickjs-libc.c
@@ -2584,11 +2584,47 @@
     return 0;
 }
 
+#if defined(__COSMOPOLITAN__)
+/* Cosmo 4.0.2's Windows slow path passes 64 handles to a wait that
+   reserves one slot for signals. Keep each call within the 63-fd limit.
+   Poll all batches before sleeping so later batches cannot starve. */
+static int js_cosmo_poll(struct pollfd *fds, int nfds, int timeout)
+{
+    int64_t deadline;
+    int offset, count, ret, ready, remaining;
+
+    if (!IsWindows())
+        return poll(fds, nfds, timeout);
+    /* NT pipe readiness is sampled before its wait. Cap that wait so the
+       task/Worker waker cannot add a 200 ms delay to every TCP read. */
+    if (nfds <= 63)
+        return poll(fds, nfds, min_int(timeout, 10));
+    deadline = get_time_ms() + timeout;
+    for (;;) {
+        ready = 0;
+        for (offset = 0; offset < nfds; offset += 63) {
+            count = min_int(nfds - offset, 63);
+            ret = poll(fds + offset, count, 0);
+            if (ret < 0)
+                return ret;
+            ready += ret;
+        }
+        if (ready || timeout == 0)
+            return ready;
+        remaining = deadline - get_time_ms();
+        if (remaining <= 0)
+            return 0;
+        if (poll(NULL, 0, min_int(remaining, 10)) < 0)
+            return -1;
+    }
+}
+#endif
