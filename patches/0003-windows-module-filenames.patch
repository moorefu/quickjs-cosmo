+
+/* Keep module identity in POSIX form even when a Windows command line
+   contains relative backslash paths. Script arguments remain unchanged. */
+char *js_std_normalize_filename(JSContext *ctx, const char *filename)
+{
+    char *normalized, *p;
+    int windows = 0;
+
+    normalized = js_strdup(ctx, filename);
+    if (!normalized)
+        return NULL;
+#if defined(__COSMOPOLITAN__)
+    windows = IsWindows();
+#elif defined(_WIN32)
+    windows = 1;
+#endif
+    if (windows) {
+        for (p = normalized; *p; p++) {
+            if (*p == '\\')
+                *p = '/';
+        }
+    }
+    return normalized;
 }
 
