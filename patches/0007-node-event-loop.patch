+JSValue js_cosmo_start_timer(JSContext *ctx, JSValueConst callback, int64_t delay, int flags)
+{
+    JSThreadState *ts = JS_GetRuntimeOpaque(JS_GetRuntime(ctx));
+    if (!ts) return JS_ThrowInternalError(ctx, "Initialize js_std_init_handlers before using timers");
+    os_poll_func = js_os_poll;
+    JSValue args[] = {callback, JS_NewInt64(ctx, delay)};
+    JSValue value = js_os_setTimeout(ctx, JS_UNDEFINED, 2, args);
+    JS_FreeValue(ctx, args[1]);
+    if (!JS_IsException(value)) {
+        int32_t identifier;
+        if (JS_ToInt32(ctx, &identifier, value) < 0) { JS_FreeValue(ctx, value); return JS_EXCEPTION; }
+        JSOSTimer *timer = find_timer_by_id(ts, identifier);
+        if (timer) timer->cosmo_flags = flags;
+    }
+    return value;
+}
+
+void js_cosmo_cancel_timer(JSContext *ctx, int identifier)
+{
+    JSThreadState *ts = JS_GetRuntimeOpaque(JS_GetRuntime(ctx));
+    JSOSTimer *timer = ts ? find_timer_by_id(ts, identifier) : NULL;
+    if (timer) free_timer(JS_GetRuntime(ctx), timer);
+}
+
+int js_cosmo_ref_timer(JSContext *ctx, int identifier, int referenced)
+{
+    JSThreadState *ts = JS_GetRuntimeOpaque(JS_GetRuntime(ctx));
+    JSOSTimer *timer = ts ? find_timer_by_id(ts, identifier) : NULL;
+    if (!timer) return 0;
+    timer->cosmo_flags = (timer->cosmo_flags & ~1) | !!referenced;
+    return 1;
+}
+
+static int has_referenced_timer(JSThreadState *ts)
+{
+    struct list_head *item;
+    list_for_each(item, &ts->os_timers) {
+        JSOSTimer *timer = list_entry(item, JSOSTimer, link);
+        if (timer->cosmo_flags & 1) return 1;
+    }
+    return 0;
+}
+
+static int poll_timer(JSContext *ctx, int *min_delay)
+{
+    JSRuntime *rt = JS_GetRuntime(ctx);
+    JSThreadState *ts = JS_GetRuntimeOpaque(rt);
+    struct list_head *item;
+    JSOSTimer *ready = NULL;
+    int64_t now = get_time_ms();
+    list_for_each(item, &ts->os_timers) {
+        JSOSTimer *timer = list_entry(item, JSOSTimer, link);
+        int64_t delay = timer->timeout - now;
+        if (delay <= 0) {
+            if (!ready) ready = timer;
+            if (ts->prefer_immediates && (timer->cosmo_flags & 2)) { ready = timer; break; }
+        } else if (delay < *min_delay) *min_delay = delay;
+    }
+    if (!ready) return 0;
+    int flags = ready->cosmo_flags;
+    JSValue function = ready->func;
+    ready->func = JS_UNDEFINED;
+    free_timer(rt, ready);
+    if (flags & 4) ts->prefer_immediates = 1;
+    else if (flags & 2) ts->prefer_immediates = 0;
+    call_handler(ctx, function);
+    JS_FreeValue(ctx, function);
+    return 1;
 }
 
