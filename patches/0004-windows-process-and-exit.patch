+#ifdef __COSMOPOLITAN__
+static int js_spawn_windows(int *pid, const char *file, char **argv,
+                            char **envp, const char *cwd, int std_fds[3],
+                            BOOL use_path)
+{
+    posix_spawn_file_actions_t actions;
+    posix_spawnattr_t attributes;
+    const char *path, *next, *end;
+    char candidate[PATH_MAX];
+    size_t len, file_len = strlen(file);
+    int err, fd, fd_max, search_err = ENOENT;
+
+    err = posix_spawn_file_actions_init(&actions);
+    if (err)
+        return err;
+    err = posix_spawnattr_init(&attributes);
+    if (err) {
+        posix_spawn_file_actions_destroy(&actions);
+        return err;
+    }
+    err = posix_spawnattr_setflags(&attributes, POSIX_SPAWN_USEVFORK);
+    if (err)
+        goto done;
+    for (fd = 0; fd < 3; fd++) {
+        if (std_fds[fd] != fd) {
+            err = posix_spawn_file_actions_adddup2(&actions, std_fds[fd], fd);
+            if (err)
+                goto done;
+        }
+    }
+    /* 与原 fork 路径保持相同的描述符清理范围。 */
+    fd_max = min_int(sysconf(_SC_OPEN_MAX), 1024);
+    if (fd_max < 0)
+        fd_max = 1024;
+    for (fd = 3; fd < fd_max; fd++) {
+        if (fcntl(fd, F_GETFD) < 0)
+            continue;
+        err = posix_spawn_file_actions_addclose(&actions, fd);
+        if (err)
+            goto done;
+    }
+    if (cwd) {
+        err = posix_spawn_file_actions_addchdir_np(&actions, cwd);
+        if (err)
+            goto done;
+    }
+    if (!file_len) {
+        err = ENOENT;
+        goto done;
+    }
+    if (!use_path || strchr(file, '/') || strchr(file, '\\') ||
+        (file_len >= 2 && file[1] == ':')) {
+        err = posix_spawn(pid, file, &actions, &attributes, argv, envp);
+        goto done;
+    }
+    /* 在子进程 cwd 下解析相对 PATH，避免临时改变父进程目录。 */
+    path = getenv("PATH");
+    if (!path)
+        path = "/bin:/usr/bin";
+    for (; path; path = next) {
+        end = strchr(path, ':');
+        next = end ? end + 1 : NULL;
+        len = end ? (size_t)(end - path) : strlen(path);
+        if (len + 1 + file_len + 1 > sizeof(candidate))
+            continue;
+        memcpy(candidate, path, len);
+        if (len)
+            candidate[len++] = '/';
+        memcpy(candidate + len, file, file_len + 1);
+        err = posix_spawn(pid, candidate, &actions, &attributes, argv, envp);
+        if (!err)
+            goto done;
+        if (err == EACCES)
+            search_err = err;
+        else if (err != ENOENT && err != ENOTDIR)
+            goto done;
+    }
+    err = search_err;
+ done:
+    posix_spawnattr_destroy(&attributes);
+    posix_spawn_file_actions_destroy(&actions);
+    return err;
+}
+#endif
